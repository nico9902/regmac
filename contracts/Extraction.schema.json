{
  "$defs": {
    "Fact": {
      "additionalProperties": false,
      "properties": {
        "subject": {
          "default": "machine",
          "title": "Subject",
          "type": "string"
        },
        "key": {
          "pattern": "^[a-z0-9_.-]+$",
          "title": "Key",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ],
          "title": "Value"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "locator": {
          "default": "document",
          "title": "Locator",
          "type": "string"
        }
      },
      "required": [
        "key",
        "value",
        "quote"
      ],
      "title": "Fact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "facts": {
      "items": {
        "$ref": "#/$defs/Fact"
      },
      "title": "Facts",
      "type": "array"
    }
  },
  "required": [
    "facts"
  ],
  "title": "Extraction",
  "type": "object"
}
