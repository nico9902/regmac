{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RegMac",
  "version": "1.1.0",
  "identifier": "it.regmac.desktop",
  "build": { "frontendDist": "../loading" },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "Pre-assessment di macchine con AI locale",
    "longDescription": "Pre-assessment documentale di macchine rispetto al Regolamento (UE) 2023/1230 e al Cyber Resilience Act (UE) 2024/2847 con AI locale (Ollama).",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": { "../../build/backend/": "backend/" },
    "macOS": { "signingIdentity": "-", "minimumSystemVersion": "12.0" }
  }
}
